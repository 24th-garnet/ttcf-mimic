{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "fluid": true,
  "functions": {
    "server.mjs": {
      "maxDuration": 300,
      "includeFiles": "{db/schema.sql,db/*.mjs,db/pg/*.mjs,app/**,spec/*.json}"
    }
  },
  "crons": [
    {
      "path": "/_warm",
      "schedule": "*/5 * * * *"
    }
  ]
}
